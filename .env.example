# Settings docker-compose.yml reads. Every one has a local/test default in
# docker-compose.yml, so this file is optional.
#
# To override:  cp .env.example .env   and edit .env (it's gitignored).
# Real secrets belong only in .env or a secret manager, never in a committed file.

# HMAC secret PayFlow signs webhooks with. whsec_test_123 is PayFlow's test-environment
# secret. If you change it, pass the same value to the sender (--secret).
PAYFLOW_WEBHOOK_SECRET=whsec_test_123

# Postgres credentials; the app's connection URL is built from them.
# Use URL-safe characters in the password (it ends up inside DATABASE_URL).
POSTGRES_USER=payflow
POSTGRES_PASSWORD=payflow
POSTGRES_DB=payflow
